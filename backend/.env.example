# MediCore Connect - Backend Environment Variables
PORT=5000
NODE_ENV=development

# Supabase API Credentials
SUPABASE_URL=https://your-project.supabase.co
# Service role key MUST NOT be exposed to client; used strictly by backend server
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-key
SUPABASE_ANON_KEY=eyJh...your-anon-public-key

# Client Origins for CORS (comma separated for multiple origins)
FRONTEND_URL=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=15
